    <collision>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <capsule radius="0.049" length="0.3"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_knee_joint" type="revolute">
    <parent link="right_hip_pitch_link"/>
    <child link="right_knee_link"/>
    <origin xyz="0 0.01 -0.403" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.0873" upper="1.7453" effort="420.0" velocity="20.0"/>
    <dynamics damping="0.2" friction="0.1"/>
