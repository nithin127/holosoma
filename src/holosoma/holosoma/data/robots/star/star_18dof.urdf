<?xml version="1.0"?>
<robot name="star_18dof">
  
  <!-- Materials -->
  <material name="body">
    <color rgba="0.8 0.3 0.6 1"/>
  </material>

  <!-- Base Link (torso) -->
  <link name="torso">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="10.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <capsule radius="0.07" length="0.14"/>
      </geometry>
      <material name="body"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <capsule radius="0.07" length="0.14"/>
      </geometry>
    </collision>
  </link>

  <!-- Head -->
  <link name="head">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <geometry>
        <sphere radius="0.09"/>
      </geometry>
      <material name="body"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.09"/>
      </geometry>
    </collision>
  </link>

  <joint name="head_fixed" type="fixed">
    <parent link="torso"/>
    <child link="head"/>
    <origin xyz="0 0 0.19" rpy="0 0 0"/>
  </joint>

  <!-- Upper Waist -->
  <link name="upper_waist">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.02"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <capsule radius="0.06" length="0.12"/>
      </geometry>
      <material name="body"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <capsule radius="0.06" length="0.12"/>
      </geometry>
    </collision>
  </link>

  <joint name="upper_waist_fixed" type="fixed">
    <parent link="torso"/>
    <child link="upper_waist"/>
    <origin xyz="-0.01 0 -0.12" rpy="0 0 0"/>
  </joint>

  <!-- Lower Waist -->
  <link name="lower_waist">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="4.0"/>
      <inertia ixx="0.04" ixy="0" ixz="0" iyy="0.04" iyz="0" izz="0.02"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <capsule radius="0.06" length="0.12"/>
      </geometry>
      <material name="body"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <capsule radius="0.06" length="0.12"/>
      </geometry>
    </collision>
  </link>

  <joint name="lower_waist_fixed" type="fixed">
    <parent link="upper_waist"/>
    <child link="lower_waist"/>
    <origin xyz="0 0 -0.14" rpy="0 0 0"/>
  </joint>

  <!-- Pelvis -->
  <link name="pelvis">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="24.227"/>
      <inertia ixx="0.825" ixy="0" ixz="0" iyy="0.68" iyz="0" izz="0.27"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <capsule radius="0.09" length="0.14"/>
      </geometry>
      <material name="body"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <capsule radius="0.09" length="0.14"/>
      </geometry>
    </collision>
  </link>

  <joint name="pelvis_fixed" type="fixed">
    <parent link="lower_waist"/>
    <child link="pelvis"/>
    <origin xyz="0.0 0 -0.165" rpy="0 0 0"/>
  </joint>

  <!-- RIGHT LEG -->
  
  <!-- Right Hip Yaw Link -->
  <link name="right_hip_yaw_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="right_hip_yaw_joint" type="revolute">
    <parent link="pelvis"/>
    <child link="right_hip_yaw_link"/>
    <origin xyz="0 -0.1 -0.04" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.8727" upper="0.3491" effort="351.0" velocity="32.0"/>
    <dynamics damping="1.0" friction="0.1"/>
  </joint>

  <!-- Right Hip Roll Link -->
  <link name="right_hip_roll_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="right_hip_roll_joint" type="revolute">
    <parent link="right_hip_yaw_link"/>
    <child link="right_hip_roll_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.3491" upper="0.1396" effort="351.0" velocity="20.0"/>
    <dynamics damping="1.0" friction="0.1"/>
  </joint>

  <!-- Right Hip Pitch Link (Thigh) -->
  <link name="right_hip_pitch_link">
    <inertial>
      <origin xyz="0 0 -0.17" rpy="0 0 0"/>
      <mass value="6.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.02"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.17" rpy="0 0 0"/>
      <geometry>
        <capsule radius="0.06" length="0.34"/>
      </geometry>
      <material name="body"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.17" rpy="0 0 0"/>
      <geometry>
        <capsule radius="0.06" length="0.34"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_hip_pitch_joint" type="revolute">
    <parent link="right_hip_roll_link"/>
    <child link="right_hip_pitch_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.5236" upper="0.6981" effort="298.0" velocity="20.0"/>
    <dynamics damping="1.0" friction="0.1"/>
  </joint>

  <!-- Right Knee Link (Shin) -->
  <link name="right_knee_link">
    <inertial>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <mass value="4.0"/>
      <inertia ixx="0.08" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.01"/>
