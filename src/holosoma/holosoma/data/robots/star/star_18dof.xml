<mujoco model="star_18dof">
  <compiler inertiafromgeom='auto' angle='degree' eulerseq='xyz'/>
  <option gravity='0 0 -10' iterations='50' integrator="RK4" solver='Newton' timestep='0.001'/>   
  <asset>
    <texture name="body" type="cube" builtin="flat" mark="cross" width="127" height="1278"
             rgb1="0.8 0.6 0.4" rgb2="0.8 0.6 0.4" markrgb="1 1 1" random="0.01"/>
    <material name="body" texture="body" texuniform="true" rgba="0.8 0.3 .6 1"/>
  </asset>

  <default>
    <geom density="1700"/>
    <motor ctrlrange="-200 200" ctrllimited="true"/>
    <default class="body">
      <geom type="capsule" condim="1" friction=".8" solimp=".9 .99 .003" solref=".015 1" material="body"/>
      <joint type="hinge" damping=".2" armature=".01" limited="true" solimplimit="0 .99 .01"/>
      <default class="big_joint">
        <joint damping="5" stiffness="10"/>
        <default class="big_stiff_joint">
          <joint stiffness="20"/>
        </default>
      </default>

      <default class="torso_density1">
        <geom density="3000"/>
      </default>
      <default class="torso_density2">
        <geom density="3000"/>
      </default>
      <default class="torso_density3">
        <geom density="2000"/>
      </default>
      <default class="pelvis_density">
        <geom density="3700"/>
      </default>
      <default class="leg_density">
        <geom density="1700"/>
      </default>
    </default>
  </default>

  <visual>
    <map force="0.1" zfar="30"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <quality shadowsize="4096"/>
    <global offwidth="800" offheight="800"/>
  </visual>

  <worldbody>
    <light name="spotlight" mode="targetbodycom" target="torso"
           diffuse=".8 .8 .8" specular="0.3 0.3 0.3" pos="0 -20 4" cutoff="10"/>
    <body name="torso" pos="0 0 1.265" childclass="body">
      <light name="top" pos="0 0 2" mode="trackcom"/>
      <camera name="back" pos="-3 0 1" xyaxes="0 -1 0 1 0 2" mode="trackcom"/>
      <camera name="side" pos="0 -5 0.5" xyaxes="1 0 0 0 1 3" mode="trackcom"/>

      <joint type="free" limited='false'/>

      <geom name="torso" class="torso_density1" fromto="0 -.07 0 0 .07 0" size=".07" />
      
      <body name="head" pos="0 0 .19">
        <geom name="head" type="sphere" size=".09"/>
        <camera name="egocentric" pos=".09 0 0" xyaxes="0 -1 0 .1 0 1" fovy="80"/>
      </body>
      
      <body name="upper_waist" pos="-.01 0 -.12">
        <inertial pos="0 0 0" mass="5.0" diaginertia="0.05 0.05 0.02"/>
        <geom name="upper_waist" class="torso_density2" fromto="0 -.06 0 0 .06 0" size=".06"/>
      </body>
      
      <body name="lower_waist" pos="-.01 0 -.26">
        <geom name="lower_waist" class="torso_density3" fromto="0 -.06 0 0 .06 0" size=".06"/>
        <body name="pelvis" pos="0 0 -.165">
        <geom name="butt" class="pelvis_density" fromto="-.04 -.07 0 -.04 .07 0" size=".09"/>
          
          <!-- LEFT LEG -->
          <body name="left_hip_yaw_link" pos="0 .1 -.04">
            <inertial pos="0 0 0" mass="1.0" diaginertia="0.001 0.001 0.001"/>
            <joint type='hinge' name="left_hip_yaw_joint" axis="0 0 -1" range="-50 20" limited='true' damping='1.0' frictionloss="0.1"/>
            <body name="left_hip_roll_link" pos="0 0 0">
              <inertial pos="0 0 0" mass="1.0" diaginertia="0.001 0.001 0.001"/>
              <joint type='hinge' name="left_hip_roll_joint" axis="-1 0 0" range="-20 8" limited='true' damping='1.0' frictionloss="0.1"/>
              <body name="left_hip_pitch_link" pos="0 0 0">
                <inertial pos="0 0 -0.17" mass="6.0" diaginertia="0.1 0.1 0.02"/>
                <joint type='hinge' name="left_hip_pitch_joint" axis="0 1 0" range="-30 40" limited='true' damping='1.0' frictionloss="0.1"/>
                <site name='left_thigh' size='0.01' pos='0 0 -0.0' euler='0 0 0' rgba ='0 1 0 1'/>
                <geom name="left_thigh" class="leg_density" fromto="0 0 0 0 -.01 -.34" size=".06"/>
                
                <body name="left_knee_link" pos="0 -.01 -.403">
                  <inertial pos="0 0 -0.15" mass="4.0" diaginertia="0.08 0.08 0.01"/>
                  <joint name="left_knee_joint" pos="0 0 .02" axis="0 1 0" range="-5 100" limited='true' damping='0.2' frictionloss="0.1"/>
                  <site name='left_shin' size='0.01' pos='0 0 -0.0' euler='0 0 0' rgba ='0 1 0 1'/>
                  <geom name="left_shin" class="leg_density" fromto="0 0 0 0 0 -.3"  size=".049" />
                  
                  <body name="left_ankle_roll_link" pos="-0.04 0 -.35">
                    <inertial pos="0 0 0" mass="0.5" diaginertia="0.001 0.001 0.001"/>
                    <joint name="left_ankle_roll_joint" pos="0 0 0.02" axis="1 0 0" range="-40 25" limited='true' damping='1.0' frictionloss="0.1"/>
                    <body name="left_ankle_pitch_link" pos="0.04 0 -0.02">
                      <inertial pos="0 0 0" mass="1.5" diaginertia="0.005 0.01 0.01"/>
                      <joint name="left_ankle_pitch_joint" pos="0 0 0" axis="0 1 0" range="-30 30" limited='true' damping='1.0' frictionloss="0.1"/>
                      <geom name="left_foot" class="leg_density" type="box" size="0.12 0.05 .02" />
                      <site name='left_foot_site' type="box" size='0.12 0.05 .01' pos='0.0 0 -0.01'/>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
          
          <!-- RIGHT LEG -->
          <body name="right_hip_yaw_link" pos="0 -.1 -.04">
            <inertial pos="0 0 0" mass="1.0" diaginertia="0.001 0.001 0.001"/>
            <joint type='hinge' name="right_hip_yaw_joint" axis="0 0 1" range="-50 20" limited='true' damping='1.0' frictionloss="0.1"/>
            <body name="right_hip_roll_link" pos="0 0 0">
              <inertial pos="0 0 0" mass="1.0" diaginertia="0.001 0.001 0.001"/>
              <joint type='hinge' name="right_hip_roll_joint" axis="1 0 0" range="-20 8" limited='true' damping='1.0' frictionloss="0.1"/>
              <body name="right_hip_pitch_link" pos="0 0 0">
                <inertial pos="0 0 -0.17" mass="6.0" diaginertia="0.1 0.1 0.02"/>
                <joint type='hinge' name="right_hip_pitch_joint" axis="0 1 0" range="-30 40" limited='true' damping='1.0' frictionloss="0.1"/>
                <site name='right_thigh' size='0.01' pos='0 0 -0.0' euler='0 0 0' rgba ='0 1 0 1'/>
                <geom name="right_thigh" class="leg_density" fromto="0 0 0 0 .01 -.34" size=".06"/>
                
                <body name="right_knee_link" pos="0 .01 -.403">
                  <inertial pos="0 0 -0.15" mass="4.0" diaginertia="0.08 0.08 0.01"/>
                  <joint type='hinge' name="right_knee_joint" pos="0 0 .02" axis="0 1 0" range="-5 100" limited='true' damping='0.2' frictionloss="0.1"/>
                  <site name='right_shin' size='0.01' pos='0 0 -0.0' euler='0 0 0' rgba ='0 1 0 1'/>
                  <geom name="right_shin" class="leg_density" fromto="0 0 0 0 0 -.3"  size=".049"/>
                  
                  <body name="right_ankle_roll_link" pos="-0.04 0 -.35">
                    <inertial pos="0 0 0" mass="0.5" diaginertia="0.001 0.001 0.001"/>
                    <joint name="right_ankle_roll_joint" pos="0 0 0.02" axis="1 0 0" range="-40 25" limited='true' damping='1.0' frictionloss="0.1"/>
                    <body name="right_ankle_pitch_link" pos="0.04 0 -0.02">
                      <inertial pos="0 0 0" mass="1.5" diaginertia="0.005 0.01 0.01"/>
                      <joint name="right_ankle_pitch_joint" pos="0 0 0" axis="0 1 0" range="-30 30" limited='true' damping='1.0' frictionloss="0.1"/>
                      <geom name="right_foot" class="leg_density" type="box" size="0.12 0.05 .02" />
                      <site name='right_foot_site' type="box" size='0.12 0.05 .01' pos='0.0 0 -0.01'/>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
          
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- LEFT LEG - order matches robot.py dof_names -->
    <motor name='left_hip_yaw_t'      joint='left_hip_yaw_joint'      ctrllimited='true' ctrlrange='-351 351'/>
    <motor name='left_hip_roll_t'     joint='left_hip_roll_joint'     ctrllimited='true' ctrlrange='-351 351'/>
    <motor name='left_hip_pitch_t'    joint='left_hip_pitch_joint'    ctrllimited='true' ctrlrange='-298 298'/>
    <motor name='left_knee_t'         joint='left_knee_joint'         ctrllimited='true' ctrlrange='-420 420'/>
    <motor name='left_ankle_roll_t'   joint='left_ankle_roll_joint'   ctrllimited='true' ctrlrange='-131 131'/>
    <motor name='left_ankle_pitch_t'  joint='left_ankle_pitch_joint'  ctrllimited='true' ctrlrange='-262 262'/>

    <!-- RIGHT LEG -->
    <motor name='right_hip_yaw_t'     joint='right_hip_yaw_joint'     ctrllimited='true' ctrlrange='-351 351'/>
    <motor name='right_hip_roll_t'    joint='right_hip_roll_joint'    ctrllimited='true' ctrlrange='-351 351'/>
    <motor name='right_hip_pitch_t'   joint='right_hip_pitch_joint'   ctrllimited='true' ctrlrange='-298 298'/>
    <motor name='right_knee_t'        joint='right_knee_joint'        ctrllimited='true' ctrlrange='-420 420'/>
    <motor name='right_ankle_roll_t'  joint='right_ankle_roll_joint'  ctrllimited='true' ctrlrange='-131 131'/>
    <motor name='right_ankle_pitch_t' joint='right_ankle_pitch_joint' ctrllimited='true' ctrlrange='-262 262'/>
  </actuator>

  <sensor>
    <touch name='touch_left_foot'   site='left_foot_site' />
    <touch name='touch_right_foot'  site='right_foot_site' />
  </sensor> 

</mujoco>